    {
      "capability_id": "area_signal.news.region",
      "constraint_type": "area_signal",
      "provider": "google_news",
      "endpoint": "google_news:search",
      "granularity": "region",
      "cost_units": 1,
      "latency_p50_ms": 1300,
      "selectivity_prior": 1,
      "observation_n": 0,
      "ttl_seconds": 86400,
      "coverage": 0.6,
      "precedence": 1,
      "enabled": true,
      "max_fanout": 6,
      "params_template": {
        "engine": "google_news",
        "q": "$constraint.self.topic",
        "location": "$stage.bounds.region_name"
      },
      "notes": "selectivity_prior of 1 because it never prunes. area_signal is always soft.",
      "produces": []
