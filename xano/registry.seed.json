{
  "registry_version": "2026-08-28.3",
  "capabilities": [
    {
      "capability_id": "candidates.zillow.region",
      "constraint_type": "candidate_source",
      "provider": "zillow",
      "endpoint": "zillow:search",
      "granularity": "region",
      "cost_units": 1,
      "latency_p50_ms": 1900,
      "selectivity_prior": 1,
      "observation_n": 0,
      "ttl_seconds": 21600,
      "coverage": 1,
      "precedence": 1,
      "enabled": true,
      "max_fanout": 1,
      "params_template": {
        "engine": "zillow",
        "status_type": "rent",
        "map_bounds": "$stage.bounds.north,$stage.bounds.east,$stage.bounds.south,$stage.bounds.west"
      },
      "notes": "One call per page. The planner emits one op per page, so the native predicates cut the pagination cost as well as the candidate count: the unfiltered San Jose pool is 20 pages, the filtered one is a single page.",
      "produces": ["entity"]
    },
    {
      "capability_id": "budget.zillow.native",
      "constraint_type": "budget",
      "provider": "zillow",
      "endpoint": "zillow:search",
      "granularity": "native",
      "cost_units": 0,
      "latency_p50_ms": 0,
      "selectivity_prior": 0.3,
      "observation_n": 0,
      "ttl_seconds": 21600,
      "coverage": 0.8,
      "precedence": 1,
      "enabled": true,
      "max_fanout": 1,
      "params_template": {
        "price": "0,$constraint.self.max_dollars"
      },
      "notes": "Free. Coverage is 0.80 because a fifth of San Jose rental results are apartment buildings that return a units[] band such as \"$2,495+\" rather than a unit price. A band straddling the cap gives unknown, never a guess.",
      "produces": []
    },
    {
      "capability_id": "unit_attribute.zillow.native",
      "constraint_type": "unit_attribute",
      "provider": "zillow",
      "endpoint": "zillow:search",
      "granularity": "native",
      "cost_units": 0,
      "latency_p50_ms": 0,
      "selectivity_prior": 0.25,
      "observation_n": 0,
      "ttl_seconds": 21600,
      "coverage": 0.8,
      "precedence": 1,
      "enabled": true,
      "max_fanout": 1,
      "params_template": {
        "beds": "$constraint.self.min,$constraint.self.max"
      },
      "notes": "Free. Multi-unit buildings carry beds inside units[] rather than at the top level, so an entity is one bed count at one building.",
      "produces": []
    },
    {
      "capability_id": "listing_feature.zillow.native",
      "constraint_type": "listing_feature",
      "provider": "zillow",
      "endpoint": "zillow:search",
      "granularity": "native",
      "cost_units": 0,
      "latency_p50_ms": 0,
      "selectivity_prior": 0.17,
      "observation_n": 0,
      "ttl_seconds": 21600,
      "coverage": 1.0,
      "precedence": 2,
      "enabled": true,
      "max_fanout": 1,
      "params_template": {
        "amenities": "$constraint.self.feature"
      },
      "notes": "Free, and Zillow guarantees survivors match. The response never restates the amenity per listing, so the evidence is provider asserted: verdict pass at confidence 0.8, citing the search rather than the listing body. Enable listing_feature.zillow.entity to upgrade that to a directly read fact.",
      "produces": []
    },
    {
      "capability_id": "listing_feature.zillow.entity",
      "constraint_type": "listing_feature",
      "provider": "zillow",
      "endpoint": "zillow:property",
      "granularity": "entity",
      "cost_units": 1,
      "latency_p50_ms": 1400,
      "selectivity_prior": 0.35,
      "observation_n": 0,
      "ttl_seconds": 21600,
      "coverage": 0.92,
      "precedence": 1,
      "enabled": false,
      "max_fanout": 24,
      "params_template": {
        "engine": "zillow_property",
        "property_id": "$entity.id"
      },
      "notes": "One detail call per surviving listing. Expensive, so it runs last and only on survivors.",
      "produces": []
    },
    {
      "capability_id": "commute.geocode.region",
      "constraint_type": "commute",
      "provider": "google_maps",
      "endpoint": "google_maps:search",
      "granularity": "region",
      "cost_units": 1,
      "latency_p50_ms": 900,
      "selectivity_prior": 1,
      "observation_n": 0,
      "ttl_seconds": 2592000,
      "coverage": 0.99,
      "precedence": 1,
      "enabled": true,
      "max_fanout": 4,
      "params_template": {
        "engine": "google_maps",
        "type": "search",
        "q": "$constraint.self.destination_raw"
      },
      "notes": "Never prunes. Returns place_results.gps_coordinates for the office address in one call.",
      "produces": ["constraint.destination_point"]
    },
    {
      "capability_id": "commute.directions.cluster",
      "constraint_type": "commute",
      "provider": "google_maps_directions",
      "endpoint": "google_maps_directions:route",
      "granularity": "cluster",
      "cost_units": 1,
      "latency_p50_ms": 2400,
      "selectivity_prior": 0.35,
      "observation_n": 0,
      "ttl_seconds": 604800,
      "coverage": 0.98,
      "precedence": 2,
      "enabled": true,
      "max_fanout": 16,
      "params_template": {
        "engine": "google_maps_directions",
        "start_coords": "$cluster.lat,$cluster.lng",
        "end_coords": "$constraint.self.destination_point",
        "travel_mode": "$constraint.self.travel_mode_code"
      },
      "notes": "travel_mode is an integer on this engine: 0 driving, 1 cycling, 2 walking, 3 transit. directions[] returns route alternatives and the first is not always the fastest, so the verdict takes the minimum duration across them. duration is already in seconds and distance in meters. Prunes with slack only: a listing can be nearer the destination than its own centroid.",
      "produces": []
    },
    {
      "capability_id": "commute.directions.entity",
      "constraint_type": "commute",
      "provider": "google_maps_directions",
      "endpoint": "google_maps_directions:route",
      "granularity": "entity",
      "cost_units": 1,
      "latency_p50_ms": 2400,
      "selectivity_prior": 0.8,
      "observation_n": 0,
      "ttl_seconds": 604800,
      "coverage": 0.98,
      "precedence": 1,
      "enabled": true,
      "max_fanout": 24,
      "params_template": {
        "engine": "google_maps_directions",
        "start_coords": "$entity.lat,$entity.lng",
        "end_coords": "$constraint.self.destination_point",
        "travel_mode": "$constraint.self.travel_mode_code"
      },
      "notes": "travel_mode is an integer on this engine: 0 driving, 1 cycling, 2 walking, 3 transit. directions[] returns route alternatives and the first is not always the fastest, so the verdict takes the minimum duration across them. duration is already in seconds and distance in meters.",
      "produces": []
    },
    {
      "capability_id": "nearby_poi.maps.cluster",
      "constraint_type": "nearby_poi",
      "provider": "google_maps",
      "endpoint": "google_maps:search",
      "granularity": "cluster",
      "cost_units": 1,
      "latency_p50_ms": 1600,
      "selectivity_prior": 0.55,
      "observation_n": 0,
      "ttl_seconds": 2592000,
      "coverage": 0.95,
      "precedence": 2,
      "enabled": true,
      "max_fanout": 16,
      "params_template": {
        "engine": "google_maps",
        "type": "search",
        "q": "$constraint.self.query",
        "ll": "@$cluster.lat,$cluster.lng,14z"
      },
      "notes": "google_local ignores ll and answers for the wrong city. google_maps with type=search honours it and carries operating_hours per weekday, which is what makes an opening time answerable rather than a guess.",
      "produces": []
    },
    {
      "capability_id": "nearby_poi.maps.entity",
      "constraint_type": "nearby_poi",
      "provider": "google_maps",
      "endpoint": "google_maps:search",
      "granularity": "entity",
      "cost_units": 1,
      "latency_p50_ms": 1600,
      "selectivity_prior": 0.9,
      "observation_n": 0,
      "ttl_seconds": 2592000,
      "coverage": 0.95,
      "precedence": 1,
      "enabled": true,
      "max_fanout": 24,
      "params_template": {
        "engine": "google_maps",
        "type": "search",
        "q": "$constraint.self.query",
        "ll": "@$entity.lat,$entity.lng,15z"
      },
      "notes": "google_local ignores ll and answers for the wrong city. google_maps with type=search honours it and carries operating_hours per weekday, which is what makes an opening time answerable rather than a guess.",
      "produces": []
    },
    {
      "capability_id": "nearby_poi.yelp.cluster",
      "constraint_type": "nearby_poi",
      "provider": "yelp",
      "endpoint": "yelp:search",
      "granularity": "cluster",
      "cost_units": 1,
      "latency_p50_ms": 1800,
      "selectivity_prior": 0.55,
      "observation_n": 0,
      "ttl_seconds": 2592000,
      "coverage": 0.7,
      "precedence": 3,
      "enabled": false,
      "max_fanout": 16,
      "params_template": {
        "engine": "yelp",
        "find_desc": "$constraint.self.query",
        "find_loc": "$cluster.lat,$cluster.lng"
      },
      "notes": "Answers the same question as Google Local at lower coverage. First thing to cut.",
      "produces": []
    },
    {
      "capability_id": "nearby_poi.reviews.entity",
      "constraint_type": "nearby_poi",
      "provider": "google_maps_reviews",
      "endpoint": "google_maps_reviews:list",
      "granularity": "entity",
      "cost_units": 1,
      "latency_p50_ms": 2100,
      "selectivity_prior": 0.95,
      "observation_n": 0,
      "ttl_seconds": 2592000,
      "coverage": 0.6,
      "precedence": 4,
      "enabled": false,
      "max_fanout": 12,
      "params_template": {
        "engine": "google_maps_reviews",
        "data_id": "$entity.id"
      },
      "notes": "Confirms hours when Google Local returns a display string we cannot parse. Second thing to cut.",
      "produces": []
