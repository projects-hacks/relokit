{
  "installCommand": "corepack enable && pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy"
    }
  ],
  "functions": {
    "api/proxy.ts": {
      "maxDuration": 60
    }
  }
}
