# Required only to record new SerpApi fixtures. Tests and the demo replay from
# fixtures/serpapi and need no keys.
SERPAPI_API_KEY=

# Parse and explain calls. NVIDIA is primary, OpenRouter is the fallback.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Xano backend.
XANO_INSTANCE_URL=
XANO_API_KEY=

# live | record | replay. Defaults to replay everywhere except tools/record-fixture.
RELOKIT_SERPAPI_MODE=replay

# Xano API group canonical for the Relokit endpoints, and the instance admin key.
# relokit_admin_key must be set to the same value in Xano's environment variables,
# alongside nvidia_api_key and serpapi_api_key.
XANO_API_GROUP=vZQqb3Je
RELOKIT_ADMIN_KEY=
# Minted by `pnpm xano:seed --create-org`. Shown once.
RELOKIT_ORG_KEY=
